# Solari — https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is "identity-linked" — those reject every request
# without it, with `anthropic-workspace-id is required`. Find it in the
# Console under Settings → Workspaces (it looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Model driving the persona loop. Haiku is ~5x cheaper and plenty good at
# "can I find the pricing page"; Sonnet writes better verdicts.
TS_BROWSE_MODEL=claude-haiku-4-5-20251001
TS_VERDICT_MODEL=claude-haiku-4-5-20251001

# Run the whole thing with no API keys and no spend: canned runs, real UI.
TS_MOCK=0

PORT=8080

# --- Payments (optional) ----------------------------------------------------
# Leave STRIPE_SECRET_KEY unset and the app runs free-with-house-limits, exactly
# as before. Set it and house-funded runs require payment first.
# Use a sk_test_... key to exercise the whole flow with Stripe's test cards.
STRIPE_SECRET_KEY=

# What one run costs a visitor. The only pricing dial.
TS_RUN_PRICE_USD=2.00

# Where Stripe sends people back to. Must be the absolute public origin.
PUBLIC_BASE_URL=http://localhost:8080

# --- Access codes (optional) ------------------------------------------------
# Comma-separated. Each code is good for exactly ONE run on the house API keys,
# free, and the holder never sees the keys. Spent codes are recorded under
# TS_STATE_DIR so a restart cannot un-spend them.
# NEVER commit real codes.
TS_ACCESS_CODES=
TS_STATE_DIR=.state
