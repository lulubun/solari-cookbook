# Solari — https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is "identity-linked" — those reject every request
# without it, with `anthropic-workspace-id is required`. Find it in the
# Console under Settings → Workspaces (it looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Model driving the persona loop. Haiku is ~5x cheaper and plenty good at
# "can I find the pricing page"; Sonnet writes better verdicts.
TS_BROWSE_MODEL=claude-haiku-4-5-20251001
TS_VERDICT_MODEL=claude-haiku-4-5-20251001

# Run the whole thing with no API keys and no spend: canned runs, real UI.
TS_MOCK=0

PORT=8080
